&i2c5 {
	status = "okay";

	rtc: rtc8563@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
	};

	eeprom: flash@50 {
		compatible = "atmel,24c32";
		reg = <0x50>;
	};

	/*lvds_touch: gt911@14 {
		compatible = "goodix,gt9xx";
		reg = <0x14>;
		pinctrl-names = "default";
		pinctrl-0 = <&lvds_touch_gpio>;
		touch-gpio = <&gpio0 RK_PA6 IRQ_TYPE_LEVEL_LOW>;
		reset-gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		max-x = <1280>;
		max-y = <800>;
		tp-size = <911>;
		tp-supply = <&vcc5v0_sys>;
		wakeup-source;
		goodix-ts-name = "lvds_ts_gt9xx";
		status = "okay";
	};*/

	ft5x06: ft5x06@38 {
		compatible = "edt,edt-ft5406";
		reg = <0x38>;
		pinctrl-names = "default";
		pinctrl-0 = <&lvds_touch_gpio>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA6 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
		touchscreen-size-x=<1024>;
		touchscreen-size-y=<600>;
		status = "okay";
    };
};

&mdio0 {
	rgmii_phy0: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
	};
};

&mdio1 {
	rgmii_phy1: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
	};
};

&dsi_dphy0 {
	status = "okay";
};

&pcie30phy {
	status = "okay";
};

&pcie3x2 {
	reset-gpios = <&gpio2 RK_PD6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie>;
	status = "disabled";
};

&pcie2x1 {
	reset-gpios = <&gpio1 RK_PB2 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie>;
	status = "okay";
};

&pinctrl {
	cam {
		camera_pwr: camera-pwr {
			rockchip,pins =
				/* camera power en */
				<0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	headphone {
		hp_det: hp-det {
			rockchip,pins = <3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PD4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	wireless-bluetooth {
		uart8_gpios: uart8-gpios {
			rockchip,pins = <2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	touch {
		lvds_touch_gpio: lvds-touch-gpio {
			rockchip,pins =
				<0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_up>,
				<0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

